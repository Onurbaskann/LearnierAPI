# Bu dosyayi .env olarak kopyalayin ve degerleri doldurun.
# .env depoya yazilmaz (bkz. .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=learnier
POSTGRES_USER=learnier
POSTGRES_PASSWORD=learnier_dev
POSTGRES_PORT=5432

# --- API ---
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5080

# --- JWT ---
# HMAC-SHA256 icin en az 32 karakter gerekir.
# Uretim degeri uretmek icin:  openssl rand -base64 48
JWT_SIGNING_KEY=local-development-only-signing-key-change-me
