<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Ortak ayarlar Directory.Build.props, paket surumleri Directory.Packages.props'tan gelir. -->

  <ItemGroup>
    <ProjectReference Include="..\Learnier.Infrastructure\Learnier.Infrastructure.csproj" />
    <ProjectReference Include="..\Learnier.Application\Learnier.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Transitive gelen acikli surumu ezmek icin acik referans (bkz. Directory.Packages.props). -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Scrutor" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <!--
      dotnet ef araclari bu paketi baslangic projesinde arar (Infrastructure'daki
      referans PrivateAssets=all oldugu icin buraya akmaz). PrivateAssets: yalnizca
      tasarim zamani araci, uretim imajina girmez.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
