{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "learnier",
    "Audience": "learnier-api",
    "AccessTokenLifetimeMinutes": 15,
    "SigningKey": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Registration": {
    "DefaultOrganizationSlug": "learnier"
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 30
  },
  "Payments": {
    "DefaultProvider": "sandbox",
    "CheckoutLifetimeMinutes": 30,
    "PublicApiBaseUrl": "http://localhost:5031",
    "SandboxWebhookSecret": ""
  },
  "CreditRenewal": {
    "Enabled": true,
    "IntervalMinutes": 5,
    "BatchSize": 100
  },
  "SessionCompletion": {
    "Enabled": true,
    "IntervalMinutes": 10,
    "BatchSize": 100,
    "GracePeriodMinutes": 15
  },
  "Meetings": {
    "ProvisioningEnabled": true,
    "DefaultProvider": "sandbox",
    "ProvisioningIntervalMinutes": 1,
    "BatchSize": 50,
    "MaxAttempts": 5,
    "PublicApiBaseUrl": "http://localhost:5031"
  },
  "AllowedHosts": "*"
}
