{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=learnier;Username=learnier;Password=learnier_dev"
  },
  "Jwt": {
    // Yalnizca yerel gelistirme icin. Uretimde ortam degiskeni ile saglanir
    // (Jwt__SigningKey) ve asla depoya yazilmaz.
    "SigningKey": "local-development-only-signing-key-change-me",
    // Yerel gelistirmede sik token yenilemeyi azaltir. Uretim degeri degismiyor;
    // istemci yine de yenileme tokeni akisini desteklemelidir.
    "AccessTokenLifetimeMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8081",
      "http://127.0.0.1:8081",
      "http://localhost:8082",
      "http://127.0.0.1:8082"
    ]
  }
}
